layout {
    tab cwd="~/git/github.com/PigeonF/dotfiles" name="dotfiles (hx)" {
        pane borderless=true edit="./todo.gitignored.md"

        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab cwd="~/git/github.com/PigeonF/dotfiles" name="dotfiles (sh)" {
        pane name="terminal"

        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
}
